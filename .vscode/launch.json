{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AnimalMovements.Api (SQLite)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AnimalMovements.Api/bin/Debug/net10.0/AnimalMovements.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/AnimalMovements.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/"
      }
    }
  ]
}
